Package: uenoyscRNA
Type: Package
Title: Publication-Quality Single-Cell RNA-Seq Visualization and Analysis Framework
Version: 0.0.1
Authors@R:
    person(
        given = "Yasuharu",
        family = "Ueno",
        email = "uenoya@ims.u-tokyo.ac.jp",
        role = c("aut", "cre")
