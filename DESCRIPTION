Package: uenoyscRNA
Type: Package
Title: Reproducible Single-Cell RNA-Seq Review Utilities
Version: 4.0.0
Authors@R: person("Yasuharu", "Ueno", role = c("aut", "cre"), email = "yasuharu.ueno@example.org")
Description: Utilities for reproducible review of Seurat single-cell RNA-seq
    objects, including annotation registries, marker registries, palettes,
    review summaries, shared metadata detection, project-wide RDS discovery, dataset registries, cell-fraction analysis, UMAP plots, FeaturePlots, and marker DotPlots. Plotting
    functions support source-RDS and analysis-date provenance footers.
License: MIT + file LICENSE
Encoding: UTF-8
LazyData: false
Depends: R (>= 4.3.0)
Imports:
    ggplot2,
    grDevices,
    grid,
    patchwork,
    rlang,
    scales,
    Seurat,
    SeuratObject,
    stats,
    utils
Suggests:
    ggrastr,
    Matrix,
    testthat (>= 3.0.0)
Config/testthat/edition: 3
Roxygen: list(markdown = TRUE)
Config/roxygen2/version: 8.0.0
